# Supabase 연결 (Project Settings → API 에서 복사)
SUPABASE_URL=https://xxxxxxxx.supabase.co
SUPABASE_ANON_KEY=eyJ...        # 앱(클라이언트)에서 사용
SUPABASE_SERVICE_ROLE_KEY=eyJ... # 엣지 함수 서버 전용 (절대 앱/단축어에 넣지 말 것)

# /ingest 공유 시크릿 (아무 긴 랜덤 문자열). 단축어 헤더 x-ingest-secret 와 동일해야 함
INGEST_SECRET=change-me-to-a-long-random-string
